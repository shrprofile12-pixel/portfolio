datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Project {
  id          String   @id @default(cuid())
  title       String
  slug        String   @unique
  description String

  imageUrl    String
  videoUrl    String?
  projectUrl  String?
  githubUrl   String?

  year        Int
  featured    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}